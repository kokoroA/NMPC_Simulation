# PowerPoint（容量が大きく GitHub の制限に抵触しやすい）
*.pptx

# Python 仮想環境（GitHub 100MB 制限を超えるバイナリを含むため除外）
.venv/
venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Claude Code のワークツリー実体（設定・フックは追跡するがここは除外）
.claude/worktrees/
.claude/settings.local.json

# SIL ビルド成果物
program/sil/build/

# SIL の実行ログ（生成物）
program/sil/runs/

# pico-sdk2 配下は Benzen_NMPC（実機ファーム本体）だけを追跡する。
# SDK 本体は上流（raspberrypi/pico-sdk）のものなのでコミットしない。
program/pico/pico-sdk2/*
!program/pico/pico-sdk2/pico-sdk/
program/pico/pico-sdk2/pico-sdk/*
!program/pico/pico-sdk2/pico-sdk/Benzen_NMPC/
